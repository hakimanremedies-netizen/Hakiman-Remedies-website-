{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/products/pashoya-pain-salt-joint-support-amp-amp-amp-amp-natural-body-detox-salt-250-g",
      "destination": "/products/pashoya-pain-salt",
      "permanent": true
    },
    {
      "source": "/products/pashoya-pain-salt-joint-support-amp-amp-amp-amp-natural-body-detox-salt-250-g-",
      "destination": "/products/pashoya-pain-salt",
      "permanent": true
    },
    {
      "source": "/products/hakiman-fizoliv-ds-syrup-sugar-free-ayurvedic-liver-amp-amp-amp-digestive-care",
      "destination": "/products/fizoliv-ds-syrup",
      "permanent": true
    },
    {
      "source": "/products/haldi-chandan-hand-made-soap-1",
      "destination": "/products/haldi-chandan-hand-made-soap",
      "permanent": true
    },
    {
      "source": "/product.php",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.+)"
        }
      ],
      "destination": "/products/:slug",
      "permanent": true
    },
    {
      "source": "/product.php",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop.php",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/category.php",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/about.php",
      "destination": "/our-story",
      "permanent": true
    },
    {
      "source": "/contact.php",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/blog.php",
      "destination": "/learn",
      "permanent": true
    },
    {
      "source": "/faq.php",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/shipping-policy.php",
      "destination": "/policies/shipping",
      "permanent": true
    },
    {
      "source": "/refund-policy.php",
      "destination": "/policies/refunds",
      "permanent": true
    },
    {
      "source": "/privacy-policy.php",
      "destination": "/policies/privacy",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions.php",
      "destination": "/policies/terms",
      "permanent": true
    },
    {
      "source": "/(login|my-account|wishlist).php",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/cart.php",
      "destination": "/cart",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(api|__shopify|checkout)(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/shopify?__p=/api/:path*" },
    { "source": "/__shopify/:path*", "destination": "/api/shopify?__p=/__shopify/:path*" },
    { "source": "/checkout", "destination": "/api/shopify?__p=/checkout" },
    { "source": "/cart/:path+", "destination": "/api/shopify?__p=/cart/:path+" },
    { "source": "/cart.js", "destination": "/api/shopify?__p=/cart.js" },
    { "source": "/cart.json", "destination": "/api/shopify?__p=/cart.json" },
    { "source": "/.well-known/ucp", "destination": "/api/shopify?__p=/.well-known/ucp" },
    { "source": "/.well-known/shopify/:path*", "destination": "/api/shopify?__p=/.well-known/shopify/:path*" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
