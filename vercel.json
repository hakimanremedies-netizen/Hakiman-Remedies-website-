{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/product.php",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>.+)" }],
      "destination": "/products/:slug",
      "permanent": true
    },
    { "source": "/product.php", "destination": "/shop", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/shop.php", "destination": "/shop", "permanent": true },
    { "source": "/category.php", "destination": "/shop", "permanent": true },
    { "source": "/about.php", "destination": "/our-story", "permanent": true },
    { "source": "/contact.php", "destination": "/contact", "permanent": true },
    { "source": "/blog.php", "destination": "/learn", "permanent": true },
    { "source": "/faq.php", "destination": "/contact", "permanent": true },
    { "source": "/shipping-policy.php", "destination": "/policies/shipping", "permanent": true },
    { "source": "/refund-policy.php", "destination": "/policies/refunds", "permanent": true },
    { "source": "/privacy-policy.php", "destination": "/policies/privacy", "permanent": true },
    { "source": "/terms-and-conditions.php", "destination": "/policies/terms", "permanent": true },
    { "source": "/(login|my-account|wishlist).php", "destination": "/account", "permanent": true },
    { "source": "/cart.php", "destination": "/checkout", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
