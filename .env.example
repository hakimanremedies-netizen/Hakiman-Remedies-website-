# Copy to .env.local (git-ignored) and fill in. Without these the site runs on the local JSON demo catalog.

# Storefront API (public, safe in the browser). From Shopify admin → Sales channels → Headless → your storefront.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Admin API, only for `npm run shopify:import`. NEVER prefix with VITE_ (that would ship it to the browser).
# Either a ready token, or a Dev Dashboard app's client id + secret (exchanged for a token at run time).
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# In-site customer sign-in (Customer Account API). Public client id, safe in the browser.
# From Shopify admin -> Sales channels -> Headless -> your storefront -> Customer Account API.
VITE_SHOPIFY_CUSTOMER_CLIENT_ID=
